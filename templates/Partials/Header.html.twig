<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}">🎨 My Gallery</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.attributes.get('_route') == 'app_home' %}active{% endif %}"
                           href="{{ path('app_home') }}">Accueil</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link {% if app.request.attributes.get('_route') == 'app_gallery' %}active{% endif %}"
                           href="{{ path('app_gallery') }}">Galerie</a>
                    </li>

                    {# Dropdown Catégories #}
                    {% set categories = get_categories() %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button"
                           data-bs-toggle="dropdown">
                            Catégories
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                            {% for category in categories %}
                                <li>
                                    <a class="dropdown-item"
                                       href="{{ path('app_gallery_by_category', { slug: category.slug }) }}">
                                        {{ category.name }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link {% if app.request.attributes.get('_route') == 'app_about' %}active{% endif %}"
                           href="{{ path('app_about') }}">À propos</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link {% if app.request.attributes.get('_route') == 'app_contact' %}active{% endif %}"
                           href="{{ path('app_contact') }}">Contact</a>
                    </li>
                </ul>

                {# Espace utilisateur #}
                <form class="d-flex ms-3">

                    {% if not app.user %}
                        <a href="{{ path('app_login') }}"
                           class="btn btn-secondary btn-sm me-2">S'identifier</a>

                        <a href="{{ path('app_register') }}" class="btn btn-secondary btn-sm">S'inscrire</a>

                    {% else %}
                        <div class="dropdown" style="padding-right: 50px;">
                            <button class="btn btn-secondary dropdown-toggle" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="{{ asset('images/avatar/' ~ app.user.imageName) }}"
                                     alt="" class="img-menu" style="width: 35px; height: 35px; border-radius: 50%;object-fit: cover">
                                &nbsp;&nbsp;{{ app.user.firstName }} {{ app.user.lastName }}
                            </button>

                            <ul class="dropdown-menu">
                                <li><a href="{{ path('app_profile') }}" class="dropdown-item ">Mon profil</a></li>
                                <li><a href="{{ path('app_profile_edit') }}" class="dropdown-item">Modifier mon profil</a></li>
                                <li><a href="{{ path('app_logout') }}" class="dropdown-item">Déconnexion</a></li>

                                {% if is_granted('ROLE_ADMIN') %}
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a href="{{ path('admin_post_index') }}" class="dropdown-item">Administration</a>
                                    </li>
                                {% endif %}
                            </ul>
                        </div>
                    {% endif %}

                </form>

            </div>
        </div>
    </nav>
</header>
