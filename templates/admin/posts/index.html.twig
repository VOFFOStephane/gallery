{% extends 'admin/base.html.twig' %}

{% block title %}Admin - Post{% endblock %}

{% block body %}
    <main class="container">
        <section class="row">
            <div class="col-md-9 offset-1">
                {% include 'admin/partials/flash.html.twig' %}
                <h1 class="display-4 pb-3">Gestion des articles</h1>
                <a href="{{ path('admin_post_new') }}" class="btn btn-outline-primary">Nouvel artile</a>
            </div>
        </section>
        <section id="posts">
            <h2 class="display-4 my-5">Tous nos articles</h2>

            {# Ton tableau ici... #}
          <div class="table-responsive">
            <table id="postsTable" class="table table-bordered table-hover">
                <thead class="table-dark">
                <tr>
                    <th>id</th>
                    <th>titre</th>
                    <th>image</th>
                    <th>categorie</th>
                    <th>auteur</th>
                    <th>technique</th>
                    <th>description</th>
                    <th>Date de création</th>
                    <th>Date d'edition</th>
                    <th>longueur</th>
                    <th>largeur</th>
                    <th>Publié ?</th>
                    <th>supprimer</th>
                    <th>editer</th>
                    <th>Masquer</th>

                </tr>
                </thead>
                <tbody>
                {% for p in posts %}
                    <tr>
                        <td>{{ p.id }}</td>
                        <td>{{ p.title }}</td>
                        <td>
                            {% if p.image %}
                                <img src="{{ asset('images/' ~ p.image) }}" alt="{{ p.title }}" style="max-width: 100px;">
                            {% else %}
                                <em>Aucune image</em>
                            {% endif %}
                        </td>
                        <td>{{ p.category.name }}</td>
                        <td>{{ p.user.firstName }} {{ p.user.lastName }}</td>
                        <td>{{ p.technique.name }}</td>
                        <td>{{ p.description |u.truncate(100, '...', false) }}</td>
                        <td>{{ p.created|date('d/m/Y') }}</td>
                        <td>{{ p.edited|date('d/m/Y') }}</td>
                        <td>{{ p.width }}</td>
                        <td>{{ p.height }}</td>
                        <td>
                            {% if p.isPublished %}
                                ✅
                            {% else %}
                                ❌
                            {% endif %}
                        </td>
                        <td class="text-center">
                            <form method="post" action="{{ path('admin_delpost', {id: p.id}) }}"
                                  onsubmit="return confirm('Confirmer la suppression de cet article ?');"
                                  style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-post' ~ p.id) }}">
                                <button type="submit" class="btn btn-outline-info">
                                    <i class="icofont-trash"></i>
                                </button>
                            </form>
                        </td>

                        <td> <a href="{{ path('admin_post_edit', {id:p.id}) }}" class="btn btn-outline-danger"><i class="icofont-edit-alt"></i></a></td>
                        <td>
                            <form method="post" action="{{ path('app_admin_hidepost', {id: p.id}) }}" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('hide-post' ~ p.id) }}">
                                <button type="submit" class="btn btn-link p-0 border-0">
                                    {% if p.isPublished %}
                                        <i class="icofont-eye"></i>
                                    {% else %}
                                        <i class="icofont-eye" style="color: red;"></i>
                                    {% endif %}
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center">Aucun article trouvé.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
          </div>
            <script>
                    $(document).ready(function () {
                    $('#postsTable').DataTable({
                        language: {
                            url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json'
                        },
                        pageLength: 5,
                        lengthMenu: [5, 10, 25, 50, 100],
                        order: [[5, 'desc']], // tri par date de création (colonne 6)
                        responsive: true
                    });
                });
            </script>
        </section>
    </main>
{% endblock %}
